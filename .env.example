# Local host ports
DFCAPTURE_PORT=8765
ADMIN_PORT=6080

# Optional Cloudflare Tunnel. Create the public hostname dwarfs.obivan.org
# in Zero Trust and point its service to:
#   http://dwarf-fortress:8765
CLOUDFLARE_TUNNEL_TOKEN=
# For reproducible production deployments, replace latest with a fixed tag.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
